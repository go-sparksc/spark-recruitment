# Copy to .env and fill in. .env is gitignored and must never be committed.

# Postgres connection string. Neon's pooled endpoint is fine for the app itself.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Optional. Only needed if `prisma migrate` fails against the pooled endpoint
# with advisory-lock or prepared-statement errors, which pgBouncer-style poolers
# can cause. Use the same URL with `-pooler` removed from the hostname.
# DIRECT_URL="postgresql://user:password@host-without-pooler/dbname?sslmode=require"

# ---------------------------------------------------------------------------
# Admin access. PRD section 8.
#
# Generate both with:  npm run hash-secret -- "your chosen password"
#
# The app refuses to start without them rather than defaulting to open: the
# instance list must not be publicly enumerable, and an empty-string secret
# would sign sessions anyone could forge.
# ---------------------------------------------------------------------------

# argon2id digest of the shared app-level password. The plaintext is never
# stored, here or anywhere. One password shared by 2-6 admins, which is why the
# sign-in form also asks for a name: it is not checked against anything and is
# not a credential, but it is what puts a person on each AuditLog row. See PRD
# decisions 16 and 93.
#
# ESCAPE EVERY DOLLAR SIGN AS \$ -- an argon2id digest is five $-delimited
# fields, and Next expands $VAR references inside .env files. Unescaped, the
# app receives a mangled string and argon2 fails with "password hash string
# missing field", which reads like a corrupted secret rather than a quoting
# problem. `npm run hash-secret` prints it already escaped.
#
# This applies to .env files only. A value pasted into Vercel's dashboard is
# not expanded and must NOT be escaped.
ADMIN_PASSWORD_HASH="\$argon2id\$v=19\$m=19456,t=2,p=1\$...\$..."

# Signs the session cookie. There is no session table, so rotating this is how
# every outstanding session is revoked at once -- do it together with the
# password if either leaks.
SESSION_SECRET=""

# ---------------------------------------------------------------------------
# Retention. PRD section 8 and decision 94.
# ---------------------------------------------------------------------------

# How many recruitment cycles are kept in full. Anything older can be archived
# from /archive: its statistics are frozen and its essays, emails, demographics
# and interview notes are deleted. §8 recommends two.
#
# Optional -- unset means 2. A value below 1, or anything that is not a whole
# number, makes the app throw rather than falling back to the default: a typo'd
# `tow` silently meaning 2 is fine right up until someone writes `1` meaning 10.
#
# Deliberately an environment variable rather than a setting inside the app.
# Everything else behind the app-level gate is additive or reversible, and that
# gate is ONE password shared by 2-6 people; a threshold editable from that side
# could be set to 0, which turns a retention control into a delete-everything
# button. Raising it to keep MORE is safe; lowering it needs a redeploy, which is
# the friction that makes it a deliberate act.
#
# Nothing is ever purged automatically. This only decides what /archive offers.
# RETENTION_CYCLES="2"

# ---------------------------------------------------------------------------
# Local development only. Not used in production.
# ---------------------------------------------------------------------------

# Hosts allowed to load dev-only assets, so the reviewer dashboard can be tested
# on a real phone -- which BUILD_PLAN's Phase 3 gate requires, and which a
# resized browser window does not satisfy.
#
# `next dev` serves its client chunks and its server actions only to the origin
# it started on. A phone on the LAN sends a different Origin header and gets a
# 403 on every chunk. The symptom is NOT an error message: the bundle never
# loads, nothing hydrates, and every button silently does nothing.
#
# Set this to the host printed as "Network" in the `next dev` banner, without
# the scheme or port, and restart the dev server. Comma-separated for several.
# DEV_ALLOWED_ORIGINS="192.168.1.110"
