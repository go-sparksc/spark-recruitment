# Copy to .env and fill in. .env is gitignored and must never be committed.

# Postgres connection string. Neon's pooled endpoint is fine for the app itself.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Optional. Only needed if `prisma migrate` fails against the pooled endpoint
# with advisory-lock or prepared-statement errors, which pgBouncer-style poolers
# can cause. Use the same URL with `-pooler` removed from the hostname.
# DIRECT_URL="postgresql://user:password@host-without-pooler/dbname?sslmode=require"

# ---------------------------------------------------------------------------
# Admin access. PRD section 8.
#
# Generate both with:  npm run hash-secret -- "your chosen password"
#
# The app refuses to start without them rather than defaulting to open: the
# instance list must not be publicly enumerable, and an empty-string secret
# would sign sessions anyone could forge.
# ---------------------------------------------------------------------------

# argon2id digest of the shared app-level password. The plaintext is never
# stored, here or anywhere. One password shared by 2-6 admins, which is why
# AuditLog.actor cannot yet name an individual -- see PRD open decision 16.
#
# ESCAPE EVERY DOLLAR SIGN AS \$ -- an argon2id digest is five $-delimited
# fields, and Next expands $VAR references inside .env files. Unescaped, the
# app receives a mangled string and argon2 fails with "password hash string
# missing field", which reads like a corrupted secret rather than a quoting
# problem. `npm run hash-secret` prints it already escaped.
#
# This applies to .env files only. A value pasted into Vercel's dashboard is
# not expanded and must NOT be escaped.
ADMIN_PASSWORD_HASH="\$argon2id\$v=19\$m=19456,t=2,p=1\$...\$..."

# Signs the session cookie. There is no session table, so rotating this is how
# every outstanding session is revoked at once -- do it together with the
# password if either leaks.
SESSION_SECRET=""
