// Spark SC recruitment platform — data model.
//
// PRD.md section 5 is the source of truth for this model. This file is its
// implementation. If the two disagree, the PRD is right and this file is a bug.
//
// The one rule that governs everything here: no score, vote, note, or decision
// references an applicant by name. They all reference `applicantId`. Name
// matching happens only at import boundaries, through the FR-13 reconciliation
// flow. Keying by name across sheets is the core defect of the spreadsheet this
// replaces, where a single typo silently orphaned a record.
//
// Prisma 7: connection URLs live in prisma.config.ts, not here.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// An instance can be COMPLETE. A round cannot, which is why these are separate.
enum InstanceStage {
  WRITTEN
  FIRST_ROUND
  SECOND_ROUND
  COMPLETE
}

/// Distinct reviewer rosters and distinct field visibility per round. See PRD section 6.
enum Round {
  WRITTEN
  FIRST_ROUND
  SECOND_ROUND
}

enum FieldCategory {
  DEMOGRAPHIC
  RESPONSE
  OTHER
}

/// What a column contributes to its group. OPTION members are the one-hot
/// checkboxes the §10.7 predicate counts. A FREE_TEXT member is displayed and
/// reconciled but never counted: being a member is what lets FR-19 find the
/// write-in, and being FREE_TEXT is what keeps it out of 1/n.
///
/// Null when the field is ungrouped. A raw-SQL CHECK enforces that groupId and
/// groupRole are set or null together; see the migration and
/// prisma/checks/field-groups.ts.
enum FieldGroupRole {
  OPTION
  FREE_TEXT
}

/// FR-2's two required designations. These columns are promoted out of
/// `Applicant.data` at commit — email because it is the join key for the FR-12
/// and FR-13 imports, display name because §6 needs it as a first-class value
/// it can hide from written reviewers.
///
/// NAME may be one column or two ("First Name" + "Last Name"), joined in
/// `ordinal` order. EMAIL is at most one per instance, enforced by a partial
/// unique index in the migration.
///
/// Neither may be excluded or grouped; a raw-SQL CHECK enforces both.
enum PromotedRole {
  EMAIL
  NAME
}

/// Which of FR-12's two uploads a staged row came from. The two sheets stage,
/// preview and commit on their own schedules (PRD decision 47), so this is what
/// keeps one sheet's staging set from being read as the other's.
enum ImportSheet {
  SCORES
  NOTES
}

/// How an FR-13 row was resolved to an applicant. The cascade runs in this
/// order and stops at the first tier that produces exactly one candidate.
///
/// MANUAL is the admin mapping a row by hand out of the unresolved queue. It is
/// deliberately a tier rather than a flag: "who decided this row points here"
/// is the question a successor asks when a score looks wrong, and a boolean
/// beside three automatic tiers would answer it only by omission.
///
/// FUZZY is the only tier that carries a matchConfidence, enforced by a CHECK.
/// It is also the only tier that is never committed without a human tick —
/// see PRD decisions 52 and 53.
enum MatchTier {
  EMAIL
  NAME
  FUZZY
  MANUAL
}

/// There is deliberately no UNRESOLVED here. An applicant left undecided when the
/// second round closes is identified by `PassApplicant.resolution = NEEDS_ADMIN` on
/// their final pass row (PRD FR-17), and stays ACTIVE. A status value would be a
/// second copy of that fact with no rule for which one wins when they disagree.
/// FR-19, FR-20 and archive-and-purge read the pass row, never this column.
/// There was also an ADVANCED here, dropped per PRD decision 41. It meant
/// "selected, not yet active in the next round" and nothing downstream read it
/// or cleared it: FR-17 defines second-round pass membership as every applicant
/// with `status = ACTIVE` and no round qualifier, so an applicant reaching the
/// second round must already be ACTIVE. FR-11's finalize therefore leaves an
/// advanced applicant ACTIVE and moves `stageReached`, which is the field that
/// actually carries how far they have got.
enum ApplicantStatus {
  ACTIVE
  REJECTED
  SPARKLET
}

enum AssignmentOrigin {
  AUTO
  MANUAL
  CLAIMED_FROM_POOL
}

enum AssignmentStatus {
  ACTIVE
  RETURNED_TO_POOL
}

/// FR-9 requires a reason when a reviewer returns an applicant to the pool.
enum ReturnReason {
  CONFLICT_OF_INTEREST
  OTHER
}

/// SKIP is both an explicit abstention and what a conflict of interest resolves to.
enum VoteValue {
  YES
  NO
  SKIP
}

enum PassStatus {
  OPEN
  CLOSED
}

/// NEEDS_ADMIN covers two situations, both requiring an admin decision: every
/// reviewer recused (PRD section 7.4), and the "Close second round" action finding
/// the applicant still undecided on the final pass. The underlying PassVote rows
/// tell them apart — eleven skips reads very differently from 7-4.
///
/// It must stay distinguishable from unanimity: an applicant every reviewer recused
/// from has not been decided, and must never be auto-resolved.
///
/// This records what happened in ONE pass. It does not control membership in the
/// next one — that is recomputed from Applicant.status at each pass creation, so an
/// applicant can carry NEEDS_ADMIN on pass 1 and still appear in pass 2.
enum PassResolution {
  SPARKLET
  REJECTED
  CARRIED
  NEEDS_ADMIN
}

enum DecisionOutcome {
  ADVANCE
  REJECT
  SPARKLET
}

enum DecisionActor {
  SYSTEM
  ADMIN
}

// ---------------------------------------------------------------------------
// Instance and configuration
// ---------------------------------------------------------------------------

/// One recruitment cycle. Instances are cycles, not customers — this is not multi-tenant.
model Instance {
  id           String        @id @default(cuid())
  name         String
  /// argon2id. Never logged, never returned by an API, never displayed.
  passwordHash String
  currentStage InstanceStage @default(WRITTEN)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  archivedAt   DateTime?

  /// Null until the FR-3 commit. Non-null is what refuses a second CSV: an
  /// instance accepts exactly one file and commit is final.
  importCommittedAt DateTime?
  /// Detected group proposals awaiting the admin's name-or-dismiss, per FR-2.
  /// Deliberately not FieldGroup rows — a group's `key` is immutable and
  /// materializing one before anyone named it would stamp "group-1" forever.
  ///
  /// Cleared at commit, and a raw-SQL CHECK holds importCommittedAt and this
  /// column mutually exclusive so that clearing cannot be lost in a refactor.
  /// Stale proposals on a committed instance would read as meaningful to a
  /// successor and could contradict the FieldGroup rows beside them.
  importProposals   Json?

  applicants          Applicant[]
  assignments         Assignment[]
  auditLogs           AuditLog[]
  fieldGroups         FieldGroup[]
  fields              Field[]
  importRows          ImportRow[]
  interviewCategories InterviewCategory[]
  interviewImports    InterviewImport[]
  interviewImportRows InterviewImportRow[]
  passes              Pass[]
  reviewers           Reviewer[]
  roundAccessCodes    RoundAccessCode[]
  rubricCategories    RubricCategory[]
}

/// Several CSV columns forming one logical question — the ten one-hot ethnicity
/// columns are one question, not ten.
///
/// Category, inclusion and the §6 visibility toggles live here rather than on
/// the members, so a group cannot end up half hidden and half visible, and the
/// §10.7 1/n counting can never run over a partially excluded set. The member's
/// own values are never read when it is grouped.
model FieldGroup {
  id         String   @id @default(cuid())
  instanceId String
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  /// Stable slug. IMMUTABLE: assigned once from the name given at creation and
  /// never re-slugged on rename — `displayName` is what a rename changes.
  /// FR-19 and FR-20 reference this, and a key that moves when someone fixes a
  /// typo is the name-keying defect this whole system exists to remove. Same
  /// split as Field.id versus Field.displayName.
  key         String
  /// Admin-editable. The heading FR-19 renders.
  displayName String
  category    FieldCategory

  /// True when members can be checked together, which is what tells the UI and
  /// the demographic aggregations to treat the group as one question.
  isMultiSelect Boolean @default(false)
  isIncluded    Boolean @default(true)
  ordinal       Int

  /// Null means "use the §6 category default for that round". Resolved by the
  /// one shared helper in lib/fields.ts, never re-derived per surface.
  visibleToWrittenReviewer    Boolean?
  visibleToFirstRoundReviewer Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fields Field[]

  @@unique([instanceId, key])
  @@index([instanceId, ordinal])
}

/// FR-2/FR-3 staging. Exists only between upload and commit.
///
/// The parsed CSV lives here rather than in the browser because a real
/// 150-applicant export with five essays each exceeds Next's 1MB server-action
/// body limit, and rather than in a temp file because that does not survive a
/// deploy. Deleted at commit; see PRD open decision 8.
model ImportRow {
  id         String   @id @default(cuid())
  instanceId String
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  /// 1-based position in the source file. Becomes Applicant.sourceRowIndex and
  /// is never renumbered, so discarding a duplicate at preview leaves a gap and
  /// "Applicant 47" keeps pointing at record 47 of the file the admin uploaded.
  rowIndex Int
  /// { columnIndex: verbatim value }. Verbatim is load-bearing: the preview
  /// reports Quinn Spacey's padded email rather than silently fixing it.
  cells    Json

  /// FR-3's discard, reversible until commit. A flag rather than a delete so
  /// rowIndex never moves — it becomes the anonymous label a written reviewer
  /// sees, and renumbering would make "Applicant 47" point at a different
  /// record than line 47 of the file the admin uploaded.
  discarded Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([instanceId, rowIndex])
  @@index([instanceId, discarded])
}

/// One per CSV column. Carries the human-facing metadata that `Applicant.data`
/// deliberately does not, so the JSONB blob stays a value store and nothing else.
model Field {
  id         String   @id @default(cuid())
  instanceId String
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  /// Exact header text from the CSV, verbatim — newlines, curly quotes, trailing
  /// spaces and all. Not unique: real form exports do emit duplicate headers, and
  /// rejecting an import over that would be the wrong behavior.
  sourceHeader String
  /// Admin-editable. Defaults to a cleaned version of sourceHeader.
  displayName  String
  category     FieldCategory

  /// The FieldGroup this column belongs to. Null for standalone columns.
  ///
  /// When set, the GROUP's category, isIncluded and visibility win over the
  /// columns below — they are kept on this row only so that ungrouping restores
  /// a sensible standalone state, and lib/fields.ts never reads them while
  /// groupId is set.
  groupId   String?
  group     FieldGroup?     @relation(fields: [groupId], references: [id], onDelete: SetNull)
  /// Set only when groupId is set, and cleared together with it. Enforced by a
  /// raw-SQL CHECK, since Prisma cannot express one; asserted by
  /// prisma/checks/field-groups.ts.
  groupRole FieldGroupRole?

  /// FR-2's designation. Null for an ordinary column. These rows are removed at
  /// FR-3 commit, when their values become Applicant.email and displayName —
  /// §6 is explicit that the promoted values are not Field rows.
  promotedRole PromotedRole?

  ordinal Int

  /// False keeps the value but excludes the column from every review surface.
  /// Junk columns like "Response Type" and "Network ID" land here. Exclusion is a
  /// presentation decision, not a lossy one, so it stays reversible without re-import.
  isIncluded Boolean @default(true)

  /// Per-round overrides for OTHER fields, which PRD section 6 makes configurable.
  /// Null means "use the category default for that round". Server-side enforcement
  /// reads these; the client is never trusted to hide anything.
  visibleToWrittenReviewer    Boolean?
  visibleToFirstRoundReviewer Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([instanceId, ordinal])
  @@index([instanceId, category])
  @@index([groupId])
}

model RubricCategory {
  id         String   @id @default(cuid())
  instanceId String
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  name       String
  maxPoints  Int
  ordinal    Int

  /// The floor of this category's scale, so a rubric can run 1..4 rather than
  /// 0..maxPoints. See PRD decision 40. Invariant `0 <= minPoints < maxPoints`,
  /// enforced in `validateRubric` beside the existing bounds.
  ///
  /// A column rather than a convention because instances are per-semester and
  /// are kept: a past cycle whose reviewers legitimately recorded a 0 must keep
  /// holding scores its own scale says are legal, which a global rule would
  /// retroactively invalidate. The scale travels with the instance that used it.
  ///
  /// Defaults to 0 so the migration changes the meaning of no existing row.
  /// `null` on a Score is unaffected — "unscored" is the absence of a Score row,
  /// never a zero, which is what makes dropping 0 from the offered values cost
  /// nothing semantically.
  minPoints Int @default(0)

  /// What this category is asking for, and what the top of its scale means.
  /// FR-9 renders it beside the score input, which is the only place a written
  /// reviewer ever sees it — without it the "rubric" they score against is a
  /// list of category names. See PRD decision 32.
  ///
  /// Nullable so an admin mid-setup is not blocked by it, and so a cycle that
  /// briefs its reviewers elsewhere can leave it empty.
  ///
  /// Covered by FR-4's lock along with the rest of the rubric: once any Score
  /// exists, changing this needs the reset that discards every score. Stated in
  /// decision 32 rather than left to be discovered.
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scores Score[]

  @@unique([instanceId, ordinal])
}

/// Per-round reviewer access code from PRD section 8. A name dropdown alone would
/// let anyone with the link vote as anyone; the code closes that at the cost of
/// one extra field.
model RoundAccessCode {
  id         String   @id @default(cuid())
  instanceId String
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  round      Round
  /// Hashed. Same rules as the instance password.
  codeHash   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([instanceId, round])
}

// ---------------------------------------------------------------------------
// Applicants and reviewers
// ---------------------------------------------------------------------------

model Applicant {
  id             String   @id @default(cuid())
  instanceId     String
  instance       Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  /// Also the anonymous label a written reviewer sees — "Applicant 47" — since
  /// PRD section 6 hides names from that round. That makes it user-facing identity,
  /// not just provenance, which is why it is unique per instance below.
  sourceRowIndex Int

  /// Promoted out of `data` because it is the join key for later imports (FR-12).
  /// Nullable: FR-3 surfaces blank-email rows for the admin to resolve.
  /// Hidden from written reviewers: a USC address is a name in disguise (section 6).
  email       String?
  /// Promoted out of `data` for display. Never used to key anything.
  /// Hidden from written reviewers per section 6.
  displayName String

  /// { fieldId: value }. JSONB rather than entity-attribute-value: CSV columns
  /// vary cycle to cycle so the schema cannot be fixed, but Postgres can still
  /// index and query inside JSONB. Keys are Field ids, never header text.
  data Json

  status       ApplicantStatus @default(ACTIVE)
  stageReached Round           @default(WRITTEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments         Assignment[]
  conflicts           ConflictOfInterest[]
  decisions           Decision[]
  firstRoundVotes     FirstRoundVote[]
  interviewImportRows InterviewImportRow[]
  interviewNotes      InterviewNotes?
  interviewResults    InterviewResult[]
  passMemberships     PassApplicant[]
  passVotes           PassVote[]

  /// FR-3 makes the admin resolve duplicate emails before commit. This makes that
  /// a database guarantee rather than a UI convention. Postgres permits many nulls
  /// in a unique index, so blank-email rows are unaffected.
  @@unique([instanceId, email])
  /// "Applicant 47" must name exactly one person. Without this, two applicants can
  /// share a label, two reviewers can score different people under one name, and a
  /// return-to-pool conversation about an applicant is ambiguous. Same class of
  /// guarantee as the email constraint above.
  @@unique([instanceId, sourceRowIndex])
  @@index([instanceId, status])
}

model Reviewer {
  id         String   @id @default(cuid())
  instanceId String
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  /// Not unique. Two reviewers can share a name — which is exactly why every
  /// vote in this schema references reviewerId instead.
  firstName String
  lastName  String

  /// An existing Spark SC member. At most one may review any given applicant.
  isSparklet Boolean @default(false)
  /// Which rounds this reviewer serves in.
  rounds     Round[]

  /// Load-bearing: PRD section 7.4 says a reviewer added mid-round votes only in
  /// passes created after they were added.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments     Assignment[]
  conflicts       ConflictOfInterest[]
  firstRoundVotes FirstRoundVote[]
  passVotes       PassVote[]

  @@index([instanceId])
}

// ---------------------------------------------------------------------------
// Written round
// ---------------------------------------------------------------------------

model Assignment {
  id          String    @id @default(cuid())
  instanceId  String
  instance    Instance  @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  round       Round
  applicantId String
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  reviewerId  String
  reviewer    Reviewer  @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  /// MANUAL marks an admin override, so regenerating assignments can warn before
  /// clobbering it rather than silently discarding a deliberate decision (FR-8).
  origin AssignmentOrigin @default(AUTO)
  status AssignmentStatus @default(ACTIVE)

  /// FR-9 requires a reason on return-to-pool. returnNote carries the free text
  /// when the reason is OTHER.
  returnReason ReturnReason?
  returnNote   String?
  returnedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  note   ReviewNote?
  scores Score[]

  @@unique([round, applicantId, reviewerId])
  @@index([instanceId, round])
  @@index([reviewerId, round, status])
}

model Score {
  id               String         @id @default(cuid())
  assignmentId     String
  assignment       Assignment     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  rubricCategoryId String
  rubricCategory   RubricCategory @relation(fields: [rubricCategoryId], references: [id], onDelete: Cascade)
  points           Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assignmentId, rubricCategoryId])
}

/// One free-text note per assignment, per FR-9.
model ReviewNote {
  id           String     @id @default(cuid())
  assignmentId String     @unique
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  body         String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// First round
// ---------------------------------------------------------------------------

/// The first-round interview rubric, per FR-12a. Instance-scoped and
/// admin-configured, per goal 5.
///
/// **Deliberately not RubricCategory.** The written rubric and the interview
/// rubric are different instruments with different categories, scored at
/// different times by different people, and goal 5 requires both be
/// reconfigurable between cycles — which rules out sharing rows and rules out
/// fixed columns. They also lock on different conditions: FR-4 locks the written
/// rubric once any Score exists, and this one locks once any
/// InterviewCategoryScore exists. See PRD decision 54 for why that keeps them on
/// separate screens too.
model InterviewCategory {
  id         String   @id @default(cuid())
  instanceId String
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  name       String
  maxPoints  Int
  ordinal    Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categoryScores InterviewCategoryScore[]

  @@unique([instanceId, ordinal])
}

/// Imported per FR-12. Two rows per applicant expected, one per interviewer.
///
/// PRD open decision 6, settled: the S26 `1R Scores` sheet carries one score per
/// configured category plus an average per interviewer, so the categories live
/// in InterviewCategoryScore and `score` holds the average.
model InterviewResult {
  id              String    @id @default(cuid())
  applicantId     String
  applicant       Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  /// Free text from the sheet. Never a Reviewer id — interviewers are not
  /// necessarily on any round's roster, and FR-12's contract is a name column.
  interviewerName String
  /// The average **exactly as the source sheet carries it**, imported verbatim
  /// and never recomputed from the category rows. If it disagrees with their
  /// mean, the sheet wins — interviewers sometimes adjust it deliberately, and
  /// that number is the one they actually recorded. FR-12 flags the
  /// disagreement in the preview rather than resolving it.
  ///
  /// Float because an average of integers is not one.
  score           Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categoryScores InterviewCategoryScore[]

  /// Makes a re-upload an upsert rather than a duplicate, per PRD decision 47.
  /// A constraint that did not need to exist when the only import path was a
  /// single commit-once CSV; FR-12 accepts repeated uploads, so it does now.
  ///
  /// Two interviewers sharing a name would collide here and merge into one row.
  /// That is the accepted cost: the sheet gives no other key, and the failure is
  /// visible at preview through decision 49's collision warning rather than
  /// silent at commit.
  @@unique([applicantId, interviewerName])
  @@index([applicantId])
}

/// One per configured category per InterviewResult, per FR-12.
model InterviewCategoryScore {
  id                  String            @id @default(cuid())
  interviewResultId   String
  interviewResult     InterviewResult   @relation(fields: [interviewResultId], references: [id], onDelete: Cascade)
  interviewCategoryId String
  interviewCategory   InterviewCategory @relation(fields: [interviewCategoryId], references: [id], onDelete: Cascade)
  points              Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([interviewResultId, interviewCategoryId])
  @@index([interviewCategoryId])
}

/// FR-12 staging header. One row per sheet, deleted at that sheet's commit and
/// taking its staged rows with it.
///
/// A table rather than a column on Instance because decision 47 gives the two
/// sheets genuinely independent lifecycles: row existence is the answer to "is
/// this sheet staged?", the question `importCommittedAt` answers for FR-3, and a
/// shared nullable column would make each sheet's commit responsible for
/// clearing half of it without disturbing the other.
model InterviewImport {
  id         String      @id @default(cuid())
  instanceId String
  instance   Instance    @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  sheet      ImportSheet

  /// The source file's header row, verbatim — same reasoning as
  /// Field.sourceHeader. The mapping table renders these, and a header that has
  /// been cleaned before the admin sees it is a header they cannot match against
  /// the file on their screen.
  headers Json
  /// { columnIndex: role }, role being one of APPLICANT_EMAIL, APPLICANT_NAME,
  /// INTERVIEWER_NAME, AVERAGE, NOTES, CATEGORY:<interviewCategoryId>, IGNORED.
  ///
  /// JSON rather than a table: the vocabulary is closed but the category half is
  /// keyed by a row id, so a Postgres enum could not express it and a join table
  /// would be four columns to say what one object says. The role union is a
  /// TypeScript type in the import module, which is where it is parsed.
  mapping Json

  uploadedAt DateTime @default(now())

  rows InterviewImportRow[]

  /// A re-upload replaces this row and cascades its staged rows away, which is
  /// FR-12's "accepts repeated uploads" without ever holding two staging sets
  /// for one sheet.
  @@unique([instanceId, sheet])
}

/// FR-12/FR-13 staging. Exists only between upload and commit for each sheet.
///
/// Same reasoning as ImportRow for living in the database rather than the
/// browser or a temp file, and the same verbatim-cells rule: the preview reports
/// what the file actually said.
model InterviewImportRow {
  id         String          @id @default(cuid())
  instanceId String
  instance   Instance        @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  importId   String
  import     InterviewImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  /// Denormalized from the parent so the unique constraint below can be stated
  /// per instance and sheet, which is the shape PRD §5 specifies and the shape
  /// the preview queries by.
  sheet      ImportSheet

  /// 1-based position in its source file.
  rowIndex Int
  /// { columnIndex: verbatim value }.
  cells    Json

  /// Set once the row is resolved to an applicant, by any tier.
  ///
  /// Cascade rather than SetNull: SetNull would clear this while leaving
  /// matchTier set, which the CHECK below forbids, so a deleted applicant would
  /// surface as a constraint violation at an unrelated moment. In practice both
  /// sides cascade from Instance together anyway.
  matchedApplicantId String?
  matchedApplicant   Applicant? @relation(fields: [matchedApplicantId], references: [id], onDelete: Cascade)
  /// Null until resolved. Paired with matchedApplicantId by a CHECK.
  matchTier          MatchTier?
  /// The similarity score, set only when matchTier = FUZZY. See PRD decisions
  /// 45 and 52. Held to that by a CHECK, since a confidence beside an EMAIL
  /// match would read as meaningful.
  matchConfidence    Float?

  /// PRD decision 51's third outcome: the admin has said this row matches nobody
  /// in the scoped pool. A decision that was made and recorded, which is what
  /// distinguishes it from a row that quietly vanished at commit.
  skipped Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([instanceId, sheet, rowIndex])
  @@index([importId, rowIndex])
  @@index([matchedApplicantId])
}

/// One row per applicant. Only one interviewer of each pair writes the notes;
/// the source sheet's "Your Name" column records which one.
model InterviewNotes {
  id              String    @id @default(cuid())
  applicantId     String    @unique
  applicant       Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  interviewerName String?
  body            String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FirstRoundVote {
  id          String    @id @default(cuid())
  applicantId String
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  reviewerId  String
  reviewer    Reviewer  @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  value       VoteValue

  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// FR-15 excludes skips from both numerator and denominator of yes%.
  @@unique([applicantId, reviewerId])
  @@index([applicantId])
}

// ---------------------------------------------------------------------------
// Second round and passes
// ---------------------------------------------------------------------------

/// Sticky across all passes once flagged (FR-16).
model ConflictOfInterest {
  id          String    @id @default(cuid())
  round       Round
  applicantId String
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  reviewerId  String
  reviewer    Reviewer  @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([round, applicantId, reviewerId])
  @@index([applicantId, round])
}

/// A second-round voting session. Sequential; exactly one is OPEN at a time.
model Pass {
  id         String     @id @default(cuid())
  instanceId String
  instance   Instance   @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  ordinal    Int
  status     PassStatus @default(OPEN)
  openedAt   DateTime   @default(now())
  closedAt   DateTime?

  members PassApplicant[]
  votes   PassVote[]

  @@unique([instanceId, ordinal])
}

/// Pass membership, fixed at creation (FR-17).
///
/// This table exists because membership cannot be reconstructed after the fact.
/// `Applicant.status` only ever shows the current state, so once an applicant is
/// resolved there is no way to ask "who was in pass 1?" without a stored roster.
/// Resolution is a property of an applicant *within a pass*, not of the applicant.
model PassApplicant {
  id          String          @id @default(cuid())
  passId      String
  pass        Pass            @relation(fields: [passId], references: [id], onDelete: Cascade)
  applicantId String
  applicant   Applicant       @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  /// Null until the applicant resolves within this pass.
  resolution  PassResolution?
  resolvedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([passId, applicantId])
  @@index([passId, resolution])
}

/// A vote requires an explicit submit. Selecting yes/no without submitting
/// records nothing, so the absence of a row is meaningful.
model PassVote {
  id          String    @id @default(cuid())
  passId      String
  pass        Pass      @relation(fields: [passId], references: [id], onDelete: Cascade)
  applicantId String
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  reviewerId  String
  reviewer    Reviewer  @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  value       VoteValue

  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([passId, applicantId, reviewerId])
  @@index([passId, applicantId])
}

// ---------------------------------------------------------------------------
// Decisions and audit
// ---------------------------------------------------------------------------

model Decision {
  id          String          @id @default(cuid())
  applicantId String
  applicant   Applicant       @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  stage       Round
  outcome     DecisionOutcome
  actor       DecisionActor
  decidedAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  /// One decision per applicant per stage. A reversal updates this row, and the
  /// previous value lands in AuditLog.
  @@unique([applicantId, stage])
  @@index([applicantId])
}

/// Admin overrides, per PRD section 8: manual assignment, manual rejection,
/// decision reversal, password reset, instance deletion. Records actor,
/// timestamp, and previous value.
model AuditLog {
  id String @id @default(cuid())

  /// NULLABLE, and SetNull rather than Cascade. Deleting an instance is the one
  /// irreversible action in the product; under Cascade the row recording that
  /// deletion is destroyed by the cascade it exists to describe, leaving the
  /// most destructive operation as the only one with no trace.
  ///
  /// deleteInstance purges the instance's other audit rows first — they
  /// describe entities about to stop existing and their previousValue can carry
  /// applicant data that retention says must not outlive the cycle — then
  /// writes the deletion record, which this FK orphans by design. Its identity
  /// lives in entityId and previousValue, not in the dead reference.
  instanceId    String?
  instance      Instance? @relation(fields: [instanceId], references: [id], onDelete: SetNull)
  actor         String
  action        String
  entityType    String
  entityId      String
  previousValue Json?
  createdAt     DateTime  @default(now())

  @@index([instanceId, createdAt])
}
